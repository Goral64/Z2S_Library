+int Supla::RegisterDevice::getMaxChannelNumberRegistered() {
+  int max = -1;
+  for (Supla::Channel *ch = Supla::Channel::Begin(); ch != nullptr;
+      ch = ch->next()) {
+    if (!ch->isExternallyRegistered() && ch->getChannelNumber() > max) {
+      max = ch->getChannelNumber();
+    }
+  }
+
+  return max;
+}
+
+bool Supla::RegisterDevice::isChannelNumberRegistered(int channelNumber) {
+  auto ch = Supla::Channel::GetByChannelNumber(channelNumber);
+  return ch != nullptr && !ch->isExternallyRegistered();
+}
+
+Supla::Channel *Supla::RegisterDevice::getRegisteredChannel(int index) {
+  if (index < 0) {
+    return nullptr;
+  }
+  int currentIndex = 0;
+  for (Supla::Channel *ch = Supla::Channel::Begin(); ch != nullptr;
+       ch = ch->next()) {
+    if (ch->isExternallyRegistered()) {
+      continue;
+    }
+    if (currentIndex == index) {
+      return ch;
+    }
+    currentIndex++;
+  }
+
+  return nullptr;
+}
